{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "id": "com.example.ai-task",
  "name": "AI任务示例",
  "description": "开发包中的虚构示例",
  "version": "1.0.2",
  "permissions": [
    "ai"
  ],
  "cards": [],
  "backend": {
    "runtime": "node",
    "entry": "backend/index.mjs",
    "lifecycle": "on-demand"
  },
  "window": {
    "entry": "frontend/index.js",
    "multiInstance": true,
    "defaultSize": {
      "width": 900,
      "height": 640
    },
    "minSize": {
      "width": 480,
      "height": 320
    }
  },
  "minCoreVersion": "0.3.2",
  "dataStores": [
    {
      "name": "state.json",
      "scope": "user",
      "schemaVersion": 1,
      "migrateFrom": []
    }
  ]
}
