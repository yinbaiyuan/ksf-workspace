{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "id": "com.example.collaboration",
  "name": "团队协作示例",
  "description": "发送任务与附件，由接收方决定处理，本地完成和结果回传分开",
  "version": "1.1.1",
  "window": {
    "entry": "frontend/index.js",
    "multiInstance": true,
    "defaultSize": {
      "width": 900,
      "height": 640
    }
  },
  "backend": {
    "runtime": "node",
    "entry": "backend/index.mjs",
    "lifecycle": "on-demand"
  },
  "permissions": [
    "messages.send",
    "messages.receive"
  ],
  "activation": {
    "messages": {
      "channels": [
        "team.workflow.v1"
      ]
    }
  },
  "cli": {
    "contractVersion": 1,
    "entry": "cli/index.mjs",
    "documentation": "docs/cli.md",
    "commands": [
      {
        "id": "inspect"
      },
      {
        "id": "peers"
      },
      {
        "id": "task.create"
      },
      {
        "id": "task.send"
      },
      {
        "id": "task.accept"
      },
      {
        "id": "task.ignore"
      },
      {
        "id": "task.complete"
      },
      {
        "id": "task.feedback"
      },
      {
        "id": "task.approve"
      },
      {
        "id": "send.status"
      },
      {
        "id": "send.reconcile"
      }
    ]
  },
  "minCoreVersion": "0.3.2",
  "dataStores": [
    {
      "name": "workflow.json",
      "scope": "user",
      "schemaVersion": 1,
      "migrateFrom": []
    }
  ]
}
