{
  "schemaVersion": 2,
  "sdkVersion": 2,
  "id": "example.cards",
  "version": "1.0.0",
  "name": "卡片验收应用",
  "description": "无主窗口，提供两种卡片；仅用于隔离验收。",
  "permissions": [],
  "cards": [
    { "id": "summary", "name": "摘要卡片", "description": "每张卡片独立配置", "entry": "frontend/summary.js", "defaultSize": { "w": 2, "h": 2 }, "minSize": { "w": 1, "h": 1 } },
    { "id": "detail", "name": "明细卡片", "description": "每张卡片独立配置", "entry": "frontend/detail.js", "defaultSize": { "w": 2, "h": 2 }, "minSize": { "w": 1, "h": 1 } }
  ],
  "backend": { "runtime": "node", "entry": "backend/index.mjs" }
}
